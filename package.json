{
  "name": "shiv-saya-properties",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "lint:fix": "eslint . --fix",
    "seed-admin": "tsx scripts/dev/seed-admins.ts",
    "analyze": "ANALYZE=true vite build",
    "size": "size-limit",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@hotjar/browser": "^1.0.9",
    "@sentry/react": "^10.65.0",
    "@tanstack/react-query": "^5.101.2",
    "algoliasearch": "^5.55.2",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.12",
    "firebase": "^12.14.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "logrocket": "^12.1.1",
    "lucide-react": "^0.460.0",
    "mixpanel-browser": "^2.81.0",
    "motion": "^12.42.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.9",
    "react-instantsearch": "^7.39.0",
    "react-joyride": "^3.2.0",
    "react-router-dom": "^7.18.1",
    "react-tooltip": "^6.0.8",
    "recharts": "^3.9.2",
    "web-vitals": "^5.3.0",
    "workbox-background-sync": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/react": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.0",
    "@size-limit/preset-app": "^12.1.0",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/mixpanel-browser": "^2.60.0",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-helmet-async": "^1.0.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "firebase-admin": "^14.1.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "react-focus-lock": "^2.13.7",
    "rollup-plugin-visualizer": "^7.0.1",
    "size-limit": "^12.1.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "size-limit": [
    {
      "path": "dist/assets/index-*.js",
      "limit": "200 kB",
      "name": "main.js"
    },
    {
      "path": "dist/assets/vendor-*.js",
      "limit": "300 kB",
      "name": "vendor.js"
    }
  ]
}
