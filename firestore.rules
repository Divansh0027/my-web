rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App Check enforcement
    function hasAppCheck() {
      // Temporarily bypassed for AI Studio dev environment due to ReCAPTCHA domain errors
      return true;
    }
    
    // Auth check
    function isAuthenticated() {
      return request.auth != null && hasAppCheck();
    }
    
    // Admin check (admins collection ONLY)
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // User owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Properties
    match /properties/{propertyId} {
      allow read: if hasAppCheck() && (
        resource == null ||
        resource.data.moderationStatus == 'live' || 
        (isAuthenticated() && resource.data.userId == request.auth.uid) || 
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && (request.resource.data.moderationStatus == 'pending' || isAdmin());
      allow update: if isAuthenticated() && (isAdmin() || (isOwner(resource.data.userId) && resource.data.moderationStatus == 'pending' && (request.resource.data.moderationStatus == 'pending' || !('moderationStatus' in request.resource.data))));
      allow delete: if isAuthenticated() && (isAdmin() || (isOwner(resource.data.userId) && resource.data.moderationStatus == 'pending'));
    }
    
    // Users
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (isAdmin() || (isOwner(userId) && (!('banned' in request.resource.data) || request.resource.data.banned == resource.data.banned)));
      allow delete: if isAdmin();
    }
    
    // Admins (read-only for client)
    match /admins/{adminId} {
      allow get: if isAuthenticated() && adminId == request.auth.uid;
      allow read: if isAdmin();
      allow write: if false; // Only via Cloud Functions or Console
    }
    
    // Enquiries
    match /enquiries/{enquiryId} {
      allow create: if hasAppCheck() && 
         enquiryId.size() <= 50 &&
         request.resource.data.keys().hasAll(['name', 'phone', 'propertyId', 'type']) &&
         request.resource.data.name is string && 
         request.resource.data.name.size() > 0 && 
         request.resource.data.name.size() <= 200 &&
         request.resource.data.phone.matches('^(\\+91)?[6-9]\\d{9}$') &&
         request.resource.data.type in ['enquiry', 'visit'] &&
        (!('message' in request.resource.data) || request.resource.data.message == '' || request.resource.data.message.size() <= 2000) &&
        request.resource.data.keys().hasOnly(['id', 'name', 'phone', 'message', 'propertyId', 'propertyName', 'dateStr', 'type', 'userId', 'userEmail', 'email', 'createdAt', 'status']);
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();    }
    
    // Favorites
    match /users/{userId}/favorites/{propertyId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticated() && isOwner(userId) && request.resource.data.userId == userId;
    }
    
    // Settings (read-only for client)
    match /settings/{docId} {
      allow read: if hasAppCheck();
      allow write: if isAdmin();
    }
    
    // Controls (read-only for client)
    match /controls/{docId} {
      allow read: if hasAppCheck();
      allow write: if isAdmin();
    }
    
    // Feedbacks
    match /feedbacks/{id} {
      allow create: if hasAppCheck();
      allow read: if isAdmin();
    }
    
        // User Behavior
    match /user_behavior/{behaviorId} {
      allow create: if true;
      allow read: if isAdmin();
    }

    // Audit logs (append-only)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
